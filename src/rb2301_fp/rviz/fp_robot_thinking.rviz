Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Reference Grid
      Enabled: true
      Cell Size: 0.5
      Plane: XY
      Plane Cell Count: 30
      Color: 130; 130; 130
      Alpha: 0.25
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/MarkerArray
      Name: Observed Map and Navigation
      Enabled: true
      Topic:
        Value: /fp_debug/markers
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Namespaces: {}
  Enabled: true
  Global Options:
    Background Color: 35; 39; 46
    Fixed Frame: fp_world
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top Down
      Angle: 0
      Scale: 100
      Target Frame: <Fixed Frame>
      X: 2.5
      Y: -1.5
    Saved: ~
Window Geometry:
  Width: 960
  Height: 700
  X: 960
  Y: 0
